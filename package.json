{
  "name": "@abwoo/deepseek-always-on",
  "version": "0.1.0-alpha.1",
  "description": "Persistent personal tasks, consented memory and notifications for DeepSeek Harness",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24.9.0"
  },
  "exports": {
    ".": {
      "types": "./dist/host/index.d.ts",
      "default": "./dist/host/index.js"
    },
    "./client": "./dist/client.js",
    "./icon": "./icon.svg",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "dist",
    "cordis.patch.yml",
    "locale",
    "icon.svg",
    "README.md",
    "README.zh-CN.md",
    "LICENSE",
    "docs"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-workspace"
      ]
    }
  },
  "scripts": {
    "build": "tsc && node scripts/build-client.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/unit/*.test.ts tests/integration/*.test.ts",
    "test:e2e": "playwright test",
    "prepack": "npm run build",
    "check": "npm run typecheck && npm run build && npm test"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.1.0",
    "@deepseek-ai/dsh-llm": "0.2.2-rc.3",
    "@deepseek-ai/dsh-tools": "0.2.2-rc.3"
  },
  "dependencies": {
    "web-push": "3.6.7",
    "zod": "4.6.6"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.1.0",
    "@deepseek-ai/dsh": "0.2.2-rc.3",
    "@deepseek-ai/dsh-agent": "0.2.2-rc.3",
    "@deepseek-ai/dsh-client-connection": "0.2.2-rc.3",
    "@deepseek-ai/dsh-host-webserver": "0.2.2-rc.3",
    "@deepseek-ai/dsh-llm": "0.2.2-rc.3",
    "@deepseek-ai/dsh-schedule": "0.2.2-rc.3",
    "@deepseek-ai/dsh-session": "0.2.2-rc.3",
    "@deepseek-ai/dsh-tools": "0.2.2-rc.3",
    "@playwright/test": "1.56.1",
    "@types/node": "^24.0.0",
    "@types/web-push": "3.6.4",
    "esbuild": "0.25.12",
    "tsx": "4.20.6",
    "typescript": "5.9.3"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/abwoo/-DeepSeek-Always-on-Personal-AI-Agent-Plugin.git"
  }
}
