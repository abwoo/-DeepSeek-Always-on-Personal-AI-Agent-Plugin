{
  "name": "@abwoo/deepseek-always-on-desktop",
  "version": "0.2.0-dev.1",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./host.mjs",
    "./client": "./client.js"
  },
  "files": [
    "host.mjs",
    "client.js",
    "bundle.yml"
  ],
  "dsh": {
    "bundle": {
      "patch": "./bundle.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.1.0",
    "@deepseek-ai/dsh-client-connection": "0.2.2-rc.3",
    "@deepseek-ai/dsh-api-gateway": "0.2.2-rc.3",
    "@deepseek-ai/dsh-api-session-controller": "0.2.2-rc.3",
    "@deepseek-ai/dsh-typert-registry": "0.2.2-rc.3",
    "@deepseek-ai/dsh-credentials": "0.2.2-rc.3"
  },
  "dependencies": {
    "ws": "8.23.0",
    "zod": "4.6.6"
  },
  "license": "MIT"
}
